{{!-- Conjuração. { name, categoryLabel, intensity, intensityLabel, die, effect, effectText, costFormula, cost, viaTome,
     requiresTrueName, calm, contained, inScar, scarRoll, helpers, helperCost, fatigue,
     test:{target,natural,success,critical}, outcome:'happens'|'failed'|'forced'|'slipped'|'curse', forceCost,
     complication, complicationRoll, pendingTarget, extraAction, annulled, stability:{from,to}, attunementDelta, attunement,
     hpChanges, strSave, undone } --}}
<div class="hda-card hda-card--cast {{#if annulled}}hda-annulled{{/if}} {{#if undone}}hda-annulled{{/if}}">
  <div class="hda-ttl">{{name}}</div>
  <div class="hda-tag v">{{categoryLabel}}{{#if intensityLabel}} · {{intensityLabel}}{{/if}}{{#if viaTome}} · {{localize 'HDA.ViaTome'}}{{/if}}{{#if requiresTrueName}} · {{localize 'HDA.TrueName'}}{{/if}}</div>
  {{#if intensity}}
  <div class="hda-result">
    <span class="hda-fo">{{die}}: {{localize 'HDA.OneDie'}}</span>
    <span class="hda-tot">{{effect}}</span>
  </div>
  {{/if}}
  {{#if test}}
  <div class="hda-result {{#if test.success}}ok{{else}}bad{{/if}}">
    <span class="hda-fo">{{localize 'HDA.WilTest'}} {{test.target}}{{#if helpers}} (+{{helpers}}){{/if}}</span>
    <span class="hda-tot">{{test.natural}}</span>
    <span class="hda-res">{{#if test.success}}{{localize 'CAIRN.Success'}}{{else}}{{localize 'CAIRN.Fail'}}{{/if}}</span>
  </div>
  {{else}}
  <div class="hda-txt">{{#if contained}}{{localize 'HDA.ContainedNoTest'}}{{else}}{{localize 'HDA.CalmNoTest'}}{{/if}}</div>
  {{/if}}
  {{#if effectText}}{{#unless (eq outcome 'curse')}}<div class="hda-txt hda-effect">{{{effectText}}}</div>{{/unless}}{{/if}}
  <div class="hda-chg"><span>{{localize 'HDA.Cost'}} ({{costFormula}}{{#if inScar}} · {{localize 'HDA.Scar'}} d6={{scarRoll}}{{/if}})</span><b>{{cost}}</b></div>
  {{#if stability}}<div class="hda-chg"><span>{{localize 'HDA.Stability'}}</span><span><s>{{stability.from}}</s> → <b>{{stability.to}}</b></span></div>{{/if}}
  {{#each hpChanges}}<div class="hda-chg"><span>{{label}}</span><span><s>{{from}}</s> → <b>{{to}}</b></span></div>{{/each}}
  {{#if fatigue}}<div class="hda-chg"><span>{{localize 'CAIRN.Fatigue'}}</span><b>+1</b></div>{{/if}}
  {{#if strSave}}<div class="hda-tag v">{{localize 'CAIRN.StrSave'}}</div>{{/if}}
  {{#if attunementDelta}}<div class="hda-txt">{{localize 'HDA.AttunementChanged' delta=attunementDelta value=attunement}}</div>{{/if}}
  {{#if helperCost}}<div class="hda-txt">{{localize 'HDA.HelpersPaid' cost=helperCost}}</div>{{/if}}
  {{#if annulled}}<div class="hda-tag v">{{localize 'HDA.Annulled'}}</div>{{/if}}
  {{#if undone}}<div class="hda-tag">{{localize 'HDA.Undone'}}</div>{{/if}}
  {{#if (eq outcome 'failed')}}
  <div class="hda-txt">{{localize 'HDA.CanForce' cost=forceCost}}</div>
  <div class="hda-btns">
    <button type="button" class="hda-pri" data-hda-action="force">{{localize 'HDA.Force'}} (−{{forceCost}})</button>
    <button type="button" data-hda-action="letSlip">{{localize 'HDA.LetSlip'}}</button>
  </div>
  {{/if}}
  {{#if (eq outcome 'forced')}}<div class="hda-tag v">{{localize 'HDA.Forced'}}</div>{{/if}}
  {{#if (eq outcome 'slipped')}}
  <div class="hda-tag v">{{localize 'HDA.Complication'}} (d6 = {{complicationRoll}})</div>
  <div class="hda-txt"><strong>{{localize (concat 'HDA.Complications.' complication '.name')}}:</strong> {{localize (concat 'HDA.Complications.' complication '.text')}}</div>
  {{#if pendingTarget}}<div class="hda-btns"><button type="button" class="hda-pri" data-hda-action="applyToTarget">{{localize 'HDA.ApplyToMarked'}}</button></div>{{/if}}
  {{/if}}
  {{#if (eq outcome 'curse')}}<div class="hda-tag v">{{localize 'HDA.CursedCast'}}</div>{{/if}}
  {{#if (or (eq outcome 'happens') (eq outcome 'forced') (eq outcome 'slipped'))}}
  {{#if (eq extraAction 'fatigueSelected')}}<div class="hda-btns"><button type="button" data-hda-action="fatigueSelected">{{localize 'HDA.FatigueInRadius'}}</button></div>{{/if}}
  {{#if (eq extraAction 'stabilitySelected')}}<div class="hda-btns"><button type="button" data-hda-action="stabilitySelected">{{localize 'HDA.StabilityForWitnesses'}}</button></div>{{/if}}
  {{/if}}
  <div class="hda-btns">
    {{#if (or (eq outcome 'happens') (eq outcome 'forced') (eq outcome 'slipped'))}}{{#unless annulled}}<button type="button" data-hda-action="annul">{{localize 'HDA.Annul'}}</button>{{/unless}}{{/if}}
    {{#unless undone}}<button type="button" data-hda-action="undo">{{localize 'HDA.Undo'}}</button>{{/unless}}
  </div>
</div>
